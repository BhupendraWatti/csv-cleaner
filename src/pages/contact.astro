---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us — CSV Cleaner" description="Have questions, bug reports, or feature requests? Contact the CSV Cleaner team for fast support.">
	<Navbar activePage="contact" />

	<main class="flex-grow flex flex-col items-center justify-center px-4 md:px-8 pt-28 pb-20 relative overflow-hidden">
		<!-- Background Elements -->
		<div class="absolute top-[-10%] left-[-10%] w-[400px] h-[400px] rounded-full bg-[#c1ecd4]/30 dark:bg-[#104430]/20 blur-[100px] pointer-events-none"></div>
		<div class="absolute bottom-[-10%] right-[-10%] w-[450px] h-[450px] rounded-full bg-[#ffdcc4]/30 dark:bg-[#451a03]/20 blur-[120px] pointer-events-none"></div>

		<div class="w-full max-w-4xl relative z-10">
			<!-- Header -->
			<div class="text-center mb-12">
				<h1 class="text-4xl md:text-5xl font-extrabold text-[#012d1d] dark:text-[#f0fdf4] font-display mb-3">How can we help?</h1>
				<p class="text-lg text-[#414844] dark:text-[#94a3b8] max-w-xl mx-auto">
					Whether you found a stubborn trailing space, a bug in our grid, or just want to say hi — we're here to assist.
				</p>
				<!-- Trust Badge -->
				<div class="inline-flex items-center gap-2 mt-6 bg-[#e8eff1] dark:bg-[#0e2019] px-4 py-1.5 rounded-full border border-[#c1c8c2] dark:border-[#1b3b2f] shadow-xs">
					<span class="material-symbols-outlined text-base text-[#3f6653] dark:text-[#34d399]" style="font-variation-settings: 'FILL' 1;">shield_lock</span>
					<span class="text-xs font-semibold uppercase tracking-wider text-[#414844] dark:text-[#94a3b8]">SECURE & PRIVATE COMMUNICATION</span>
				</div>
			</div>

			<!-- Grid Layout for Form & Info -->
			<div class="grid grid-cols-1 md:grid-cols-12 gap-8">
				<!-- Form Card -->
				<div class="md:col-span-8 bg-white dark:bg-[#0e2019] rounded-2xl shadow-sm border border-[#c1c8c2] dark:border-[#1b3b2f] p-6 md:p-8 relative overflow-hidden">
					<!-- Success Overlay -->
					<div id="success-state" class="hidden absolute inset-0 bg-white dark:bg-[#0e2019] z-20 flex flex-col items-center justify-center text-center p-8">
						<div class="w-16 h-16 rounded-full bg-[#c1ecd4] dark:bg-[#104430] flex items-center justify-center mb-4 text-[#012d1d] dark:text-[#34d399]">
							<span class="material-symbols-outlined text-4xl" style="font-variation-settings: 'FILL' 1;">check_circle</span>
						</div>
						<h3 class="text-2xl font-bold text-[#012d1d] dark:text-[#f0fdf4] font-display mb-2">Message Sent!</h3>
						<p class="text-sm text-[#414844] dark:text-[#94a3b8] max-w-xs">We've received your inquiry and will get back to you within 24 hours.</p>
						<button id="reset-form-btn" class="mt-6 text-xs font-semibold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] hover:underline cursor-pointer">Send another message</button>
					</div>

					<form id="contact-form" class="space-y-6">
						<!-- Topic -->
						<div class="space-y-2">
							<label for="inquiry-type" class="block text-xs font-semibold uppercase tracking-wider text-[#414844] dark:text-[#94a3b8]">I am reaching out about...</label>
							<select id="inquiry-type" name="inquiry-type" class="w-full bg-[#f4fafd] dark:bg-[#0a1713] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-lg px-4 py-3 text-sm text-[#161d1f] dark:text-[#f0fdf4] focus:outline-none focus:border-[#012d1d] dark:focus:border-[#34d399]">
								<option value="general" className="dark:bg-[#0a1713]">General Question</option>
								<option value="bug" className="dark:bg-[#0a1713]">Bug Report</option>
								<option value="feature" className="dark:bg-[#0a1713]">Feature Request</option>
								<option value="privacy" className="dark:bg-[#0a1713]">Privacy & Security Inquiry</option>
							</select>
						</div>

						<!-- Email -->
						<div class="space-y-2">
							<label for="email" class="block text-xs font-semibold uppercase tracking-wider text-[#414844] dark:text-[#94a3b8]">Email Address</label>
							<input id="email" name="email" type="email" placeholder="you@company.com" required class="w-full bg-[#f4fafd] dark:bg-[#0a1713] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-lg px-4 py-3 text-sm text-[#161d1f] dark:text-[#f0fdf4] focus:outline-none focus:border-[#012d1d] dark:focus:border-[#34d399] placeholder:text-muted-foreground" />
						</div>

						<!-- Message -->
						<div class="space-y-2">
							<label for="message" class="block text-xs font-semibold uppercase tracking-wider text-[#414844] dark:text-[#94a3b8]">Details</label>
							<textarea id="message" name="message" rows="5" placeholder="Tell us what's on your mind..." required class="w-full bg-[#f4fafd] dark:bg-[#0a1713] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-lg px-4 py-3 text-sm text-[#161d1f] dark:text-[#f0fdf4] resize-none focus:outline-none focus:border-[#012d1d] dark:focus:border-[#34d399] placeholder:text-muted-foreground"></textarea>
						</div>

						<!-- Submit Button -->
						<div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
							<p class="text-xs text-[#57615c] dark:text-[#94a3b8] flex items-center gap-1">
								<span class="material-symbols-outlined text-base">info</span>
								We usually reply within 24 hours.
							</p>
							<button type="submit" class="w-full sm:w-auto bg-[#012d1d] dark:bg-[#34d399] text-white dark:text-[#002114] font-semibold text-xs uppercase tracking-wider px-6 py-3.5 rounded-lg hover:bg-[#1b4332] dark:hover:bg-[#2dd4bf] transition-colors shadow-xs flex items-center justify-center gap-2 cursor-pointer">
								<span>Send Message</span>
								<span class="material-symbols-outlined text-base">send</span>
							</button>
						</div>
					</form>
				</div>

				<!-- Direct Contact Info Card -->
				<div class="md:col-span-4 flex flex-col gap-6">
					<div class="bg-gradient-to-br from-[#012d1d] to-[#1b4332] dark:from-[#0a2318] dark:to-[#104430] text-white rounded-2xl p-6 shadow-sm flex flex-col justify-between flex-grow border dark:border-[#34d399]/30">
						<div>
							<span class="text-xs font-semibold uppercase tracking-wider text-[#a5d0b9] block mb-4">Direct Support</span>
							<h3 class="text-2xl font-bold font-display mb-3">Fast & Direct Assistance</h3>
							<p class="text-xs text-[#a5d0b9] leading-relaxed mb-6">Need help debugging a complex CSV format? Drop us an email or join our community discussions.</p>
						</div>

						<div class="space-y-4 pt-4 border-t border-[#a5d0b9]/20 dark:border-[#34d399]/20">
							<a href="mailto:support@csvcleaner.app" class="flex items-center gap-3 group text-xs text-white">
								<div class="size-8 rounded-full bg-[#c1ecd4]/20 dark:bg-[#34d399]/20 flex items-center justify-center text-[#c1ecd4] dark:text-[#34d399] group-hover:bg-[#c1ecd4] group-hover:text-[#012d1d] transition-colors">
									<span class="material-symbols-outlined text-base">mail</span>
								</div>
								<span>support@csvcleaner.app</span>
							</a>

							<a href="/faq" class="flex items-center gap-3 group text-xs text-white">
								<div class="size-8 rounded-full bg-[#c1ecd4]/20 dark:bg-[#34d399]/20 flex items-center justify-center text-[#c1ecd4] dark:text-[#34d399] group-hover:bg-[#c1ecd4] group-hover:text-[#012d1d] transition-colors">
									<span class="material-symbols-outlined text-base">quiz</span>
								</div>
								<span>Browse Knowledge Base</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</main>

	<Footer />

	<script>
		document.addEventListener('DOMContentLoaded', () => {
			const form = document.getElementById('contact-form') as HTMLFormElement;
			const successState = document.getElementById('success-state');
			const resetBtn = document.getElementById('reset-form-btn');

			if (form && successState) {
				form.addEventListener('submit', (e) => {
					e.preventDefault();
					successState.classList.remove('hidden');
				});
			}

			if (resetBtn && form && successState) {
				resetBtn.addEventListener('click', () => {
					successState.classList.add('hidden');
					form.reset();
				});
			}
		});
	</script>
</Layout>
