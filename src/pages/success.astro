---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout
	title="Export CSV — CSV Cleaner"
	description="Return to the CSV Cleaner workspace to verify and export your cleaned dataset."
>
	<Navbar showHealthBadge={false} />

	<main class="flex-grow pt-28 bg-[#f4fafd] dark:bg-[#06120e] min-h-screen flex flex-col items-center justify-center px-6 pb-12">
		<section class="max-w-md w-full text-center bg-white dark:bg-[#0e2019] rounded-2xl p-8 border border-[#c1c8c2] dark:border-[#1b3b2f] shadow-ambient flex flex-col gap-5">
			<div class="size-16 rounded-full bg-[#e8eff1] dark:bg-[#162f25] text-[#012d1d] dark:text-[#34d399] mx-auto flex items-center justify-center">
				<span class="material-symbols-outlined text-4xl">download</span>
			</div>

			<div class="flex flex-col gap-2">
				<h1 class="text-3xl font-extrabold text-[#012d1d] dark:text-[#f0fdf4] font-display">Export from your workspace</h1>
				<p class="text-sm text-[#414844] dark:text-[#94a3b8]">
					Cleaned files are generated only after the active dataset passes structural verification.
					For privacy, CSV data and download links are never stored on this page.
				</p>
			</div>

			<a
				href="/#workspace-container"
				class="inline-flex items-center justify-center gap-2 bg-[#012d1d] dark:bg-[#34d399] text-white dark:text-[#002114] text-xs font-semibold uppercase tracking-wider px-6 py-3 rounded-lg hover:bg-[#1b4332] dark:hover:bg-[#2dd4bf] shadow-ambient transition-colors"
			>
				<span class="material-symbols-outlined text-base">arrow_back</span>
				Return to CSV Cleaner
			</a>
		</section>
	</main>

	<Footer />
</Layout>
