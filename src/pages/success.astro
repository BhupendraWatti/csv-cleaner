---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout
	title="Export CSV — CSV Cleaner"
	description="Return to the CSV Cleaner workspace to verify and export your cleaned dataset."
>
	<Navbar showHealthBadge={false} />

	<main class="flex-grow pt-28 bg-[#f4fafd] min-h-screen flex items-center justify-center px-6">
		<section class="max-w-md w-full text-center bg-white rounded-2xl p-8 border border-[#c1c8c2] shadow-ambient flex flex-col gap-5">
			<div class="size-16 rounded-full bg-[#e8eff1] text-[#012d1d] mx-auto flex items-center justify-center">
				<span class="material-symbols-outlined text-4xl">download</span>
			</div>

			<div class="flex flex-col gap-2">
				<h1 class="text-3xl font-extrabold text-[#012d1d] font-display">Export from your workspace</h1>
				<p class="text-sm text-[#414844]">
					Cleaned files are generated only after the active dataset passes structural verification.
					For privacy, CSV data and download links are never stored on this page.
				</p>
			</div>

			<a
				href="/#workspace-container"
				class="inline-flex items-center justify-center gap-2 bg-[#012d1d] text-white text-xs font-semibold uppercase tracking-wider px-6 py-3 rounded-lg hover:bg-[#1b4332] shadow-ambient transition-colors"
			>
				<span class="material-symbols-outlined text-base">arrow_back</span>
				Return to CSV Cleaner
			</a>
		</section>
	</main>
</Layout>
