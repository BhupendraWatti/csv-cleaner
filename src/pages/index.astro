---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CSVCleaner from '../components/CSVCleaner';
import ErrorBoundary from '../components/csv/ErrorBoundary';
---

<Layout title="CSV Cleaner — Clean, Fix & Export Spreadsheets in Seconds. 100% Private.">
	<Navbar activePage="home" />

	<main class="flex-grow bg-[#f4fafd] dark:bg-[#06120e] transition-colors duration-200">

		<!-- ═══════════════════════════════════════════
		     SECTION 1: HERO + TOOL WORKSPACE
		     ═══════════════════════════════════════════ -->
		<section class="pt-24 pb-10 px-4 sm:px-6">
			<div class="max-w-7xl mx-auto space-y-6">

				<!-- Trust badge + Hero copy -->
				<div class="text-center max-w-3xl mx-auto space-y-4">
					<div class="inline-flex items-center gap-2 bg-white dark:bg-[#0e2019] border border-[#c1c8c2] dark:border-[#1b3b2f] px-4 py-1.5 rounded-full shadow-xs">
						<span class="w-2 h-2 bg-[#3f6653] dark:bg-[#34d399] rounded-full animate-pulse"></span>
						<span class="text-xs font-semibold text-[#012d1d] dark:text-[#f0fdf4] tracking-wide">100% Private · Zero Uploads · Runs In Your Browser</span>
					</div>

					<h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#161d1f] dark:text-[#f0fdf4] font-display leading-[1.1] tracking-tight">
						Messy CSV?<br />
						<span class="text-[#012d1d] dark:text-[#34d399]">Clean it right here.</span>
					</h1>

					<p class="text-base sm:text-lg text-[#414844] dark:text-[#94a3b8] leading-relaxed max-w-xl mx-auto">
						Drag & drop your spreadsheet. Instantly diagnose 12+ error types, trim whitespace, merge duplicates, and export pristine data.
					</p>

					<!-- Quick stat badges -->
					<div class="flex flex-wrap items-center justify-center gap-3 pt-1">
						<span class="inline-flex items-center gap-1.5 bg-[#c1ecd4]/50 dark:bg-[#104430] text-[#012d1d] dark:text-[#34d399] text-xs font-semibold px-3 py-1 rounded-full border border-[#a5d0b9] dark:border-[#1b3b2f]">
							<span class="material-symbols-outlined text-sm" style="font-variation-settings:'FILL' 1">bolt</span>
							Instant Processing
						</span>
						<span class="inline-flex items-center gap-1.5 bg-[#c1ecd4]/50 dark:bg-[#104430] text-[#012d1d] dark:text-[#34d399] text-xs font-semibold px-3 py-1 rounded-full border border-[#a5d0b9] dark:border-[#1b3b2f]">
							<span class="material-symbols-outlined text-sm" style="font-variation-settings:'FILL' 1">lock</span>
							No Data Leaves Device
						</span>
						<span class="inline-flex items-center gap-1.5 bg-[#c1ecd4]/50 dark:bg-[#104430] text-[#012d1d] dark:text-[#34d399] text-xs font-semibold px-3 py-1 rounded-full border border-[#a5d0b9] dark:border-[#1b3b2f]">
							<span class="material-symbols-outlined text-sm" style="font-variation-settings:'FILL' 1">download</span>
							CSV / JSON / XLSX Export
						</span>
					</div>
				</div>

				<!-- ─── THE MAIN TOOL WORKSPACE ─── -->
				<div id="workspace-container" class="scroll-mt-24 w-full">
					<ErrorBoundary client:only="react">
						<CSVCleaner client:only="react" />
					</ErrorBoundary>
				</div>

			</div>
		</section>

		<!-- ═══════════════════════════════════════════
		     SECTION 2: WHAT IT DETECTS (Feature strips)
		     ═══════════════════════════════════════════ -->
		<section class="py-14 px-4 sm:px-6 border-t border-[#c1c8c2]/40 dark:border-[#1b3b2f]">
			<div class="max-w-7xl mx-auto">
				<div class="text-center mb-10 space-y-2">
					<p class="text-xs font-bold uppercase tracking-widest text-[#3f6653] dark:text-[#34d399]">Automated Error Detection</p>
					<h2 class="text-2xl sm:text-3xl font-extrabold text-[#012d1d] dark:text-[#f0fdf4] font-display">12+ Issue Types Fixed Automatically</h2>
					<p class="text-sm text-[#57615c] dark:text-[#94a3b8] max-w-xl mx-auto">We catch the issues that break database imports before you even see them.</p>
				</div>

				<!-- 3-col detection grid — equal height cards -->
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

					<!-- Card 1 -->
					<div class="bg-white dark:bg-[#0e2019] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-2xl p-5 flex flex-col gap-4 hover:border-[#012d1d] hover:dark:border-[#34d399] hover:shadow-md transition-all duration-200">
						<div class="flex items-center gap-3">
							<div class="w-10 h-10 rounded-xl bg-[#ffdad6]/70 dark:bg-red-950/60 flex items-center justify-center shrink-0">
								<span class="material-symbols-outlined text-[#ba1a1a] dark:text-red-400 text-xl">space_bar</span>
							</div>
							<h3 class="text-base font-bold text-[#161d1f] dark:text-[#f0fdf4] font-display">Extra Spaces</h3>
						</div>
						<div class="flex-1 bg-[#f4fafd] dark:bg-[#0a1713] rounded-xl border border-[#c1c8c2]/50 dark:border-[#1b3b2f] p-3 font-mono text-xs space-y-2">
							<div class="flex items-center justify-between gap-2">
								<span class="text-[#57615c] dark:text-[#94a3b8] shrink-0">Before</span>
								<span class="bg-[#ffdad6] dark:bg-red-950/60 text-[#ba1a1a] dark:text-red-300 px-2 py-0.5 rounded border border-[#ba1a1a]/20 dark:border-red-900/40 truncate">"&nbsp;&nbsp;John Doe&nbsp;&nbsp;"</span>
							</div>
							<div class="text-center text-[#c1c8c2] dark:text-[#1b3b2f]">↓</div>
							<div class="flex items-center justify-between gap-2">
								<span class="text-[#57615c] dark:text-[#94a3b8] shrink-0">After</span>
								<span class="bg-[#c1ecd4] dark:bg-[#104430] text-[#002114] dark:text-[#34d399] px-2 py-0.5 rounded border border-[#012d1d]/20 dark:border-[#34d399]/30">"John Doe"</span>
							</div>
						</div>
					</div>

					<!-- Card 2 -->
					<div class="bg-white dark:bg-[#0e2019] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-2xl p-5 flex flex-col gap-4 hover:border-[#012d1d] hover:dark:border-[#34d399] hover:shadow-md transition-all duration-200">
						<div class="flex items-center gap-3">
							<div class="w-10 h-10 rounded-xl bg-[#ffdcc4]/70 dark:bg-amber-950/60 flex items-center justify-center shrink-0">
								<span class="material-symbols-outlined text-[#5f2f00] dark:text-amber-400 text-xl">content_copy</span>
							</div>
							<h3 class="text-base font-bold text-[#161d1f] dark:text-[#f0fdf4] font-display">Duplicate Rows</h3>
						</div>
						<div class="flex-1 bg-[#f4fafd] dark:bg-[#0a1713] rounded-xl border border-[#c1c8c2]/50 dark:border-[#1b3b2f] p-3 font-mono text-xs space-y-1.5">
							<div class="bg-white dark:bg-[#0e2019] px-2.5 py-1.5 rounded border border-[#c1c8c2]/60 dark:border-[#1b3b2f] text-[#161d1f] dark:text-[#f0fdf4] truncate">1, Sarah, sarah@acme.co</div>
							<div class="bg-[#ffdcc4]/50 dark:bg-amber-950/50 text-[#3f1d00] dark:text-amber-300 px-2.5 py-1.5 rounded border border-[#5f2f00]/20 dark:border-amber-900/40 line-through truncate">1, Sarah, sarah@acme.co</div>
							<div class="bg-white dark:bg-[#0e2019] px-2.5 py-1.5 rounded border border-[#c1c8c2]/60 dark:border-[#1b3b2f] text-[#161d1f] dark:text-[#f0fdf4] truncate">2, David, david@co.io</div>
						</div>
					</div>

					<!-- Card 3 -->
					<div class="bg-white dark:bg-[#0e2019] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-2xl p-5 flex flex-col gap-4 hover:border-[#012d1d] hover:dark:border-[#34d399] hover:shadow-md transition-all duration-200 sm:col-span-2 lg:col-span-1">
						<div class="flex items-center gap-3">
							<div class="w-10 h-10 rounded-xl bg-[#d8e2dc] dark:bg-[#162f25] flex items-center justify-center shrink-0">
								<span class="material-symbols-outlined text-[#57615c] dark:text-[#34d399] text-xl">delete_sweep</span>
							</div>
							<h3 class="text-base font-bold text-[#161d1f] dark:text-[#f0fdf4] font-display">Empty Rows & Columns</h3>
						</div>
						<div class="flex-1 bg-[#f4fafd] dark:bg-[#0a1713] rounded-xl border border-[#c1c8c2]/50 dark:border-[#1b3b2f] p-3 font-mono text-xs space-y-1.5">
							<div class="bg-white dark:bg-[#0e2019] px-2.5 py-1.5 rounded border border-[#c1c8c2]/60 dark:border-[#1b3b2f] text-[#161d1f] dark:text-[#f0fdf4]">Data Row 1</div>
							<div class="border border-dashed border-[#c1c8c2] dark:border-[#1b3b2f] h-7 rounded flex items-center justify-center gap-1.5">
								<span class="material-symbols-outlined text-xs text-[#717973] dark:text-[#94a3b8]">close</span>
								<span class="text-[10px] text-[#717973] dark:text-[#94a3b8]">Blank line purged</span>
							</div>
							<div class="bg-white dark:bg-[#0e2019] px-2.5 py-1.5 rounded border border-[#c1c8c2]/60 dark:border-[#1b3b2f] text-[#161d1f] dark:text-[#f0fdf4]">Data Row 2</div>
						</div>
					</div>

				</div>
			</div>
		</section>

		<!-- ═══════════════════════════════════════════
		     SECTION 3: CSV TOOLS DIRECTORY (6 tools)
		     ═══════════════════════════════════════════ -->
		<section class="py-14 px-4 sm:px-6 border-t border-[#c1c8c2]/40 dark:border-[#1b3b2f] bg-white dark:bg-[#0a1713]">
			<div class="max-w-7xl mx-auto">

				<div class="text-center mb-10 space-y-2">
					<p class="text-xs font-bold uppercase tracking-widest text-[#3f6653] dark:text-[#34d399]">Suite of Utilities</p>
					<h2 class="text-2xl sm:text-3xl font-extrabold text-[#012d1d] dark:text-[#f0fdf4] font-display">CSV Tools Directory</h2>
					<p class="text-sm text-[#57615c] dark:text-[#94a3b8] max-w-xl mx-auto">Pick a specialized tool or use the full cleaner pipeline above.</p>
				</div>

				<!-- 6 tool cards — equal height, perfectly aligned -->
				<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">

					<!-- Tool 1 -->
					<div class="group flex flex-col bg-[#012d1d] dark:bg-[#104430] text-white rounded-2xl p-6 hover:bg-[#1b4332] dark:hover:bg-[#162f25] border dark:border-[#34d399]/40 transition-colors duration-200 shadow-md">
						<div class="w-11 h-11 bg-[#c1ecd4] dark:bg-[#34d399] text-[#012d1d] dark:text-[#002114] rounded-xl flex items-center justify-center mb-4">
							<span class="material-symbols-outlined text-2xl">mop</span>
						</div>
						<h3 class="text-lg font-bold font-display mb-2">CSV Cleaner Pipeline</h3>
						<p class="text-sm text-[#a5d0b9] leading-relaxed flex-1">The complete pipeline. Detect issues, standardize formatting, and apply multiple cleaning rules in a single pass.</p>
						<a href="#workspace-container" class="mt-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#c1ecd4] dark:text-[#34d399] hover:text-white transition-colors">
							<span>Use Full Cleaner</span>
							<span class="material-symbols-outlined text-base">arrow_forward</span>
						</a>
					</div>

					<!-- Tool 2 -->
					<div class="group flex flex-col bg-white dark:bg-[#0e2019] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-2xl p-6 hover:border-[#012d1d] hover:dark:border-[#34d399] hover:shadow-md transition-all duration-200">
						<div class="w-11 h-11 bg-[#d8e2dc] dark:bg-[#162f25] text-[#012d1d] dark:text-[#34d399] rounded-xl flex items-center justify-center mb-4">
							<span class="material-symbols-outlined text-2xl">difference</span>
						</div>
						<h3 class="text-lg font-bold text-[#012d1d] dark:text-[#f0fdf4] font-display mb-2">Remove Duplicates</h3>
						<p class="text-sm text-[#414844] dark:text-[#94a3b8] leading-relaxed flex-1">Identify and eliminate exact or fuzzy duplicate rows across your dataset or on specific key columns.</p>
						<a href="#workspace-container" class="mt-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] hover:text-[#1b4332] dark:hover:text-[#2dd4bf] transition-colors">
							<span>Remove Duplicates</span>
							<span class="material-symbols-outlined text-base">arrow_forward</span>
						</a>
					</div>

					<!-- Tool 3 -->
					<div class="group flex flex-col bg-white dark:bg-[#0e2019] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-2xl p-6 hover:border-[#012d1d] hover:dark:border-[#34d399] hover:shadow-md transition-all duration-200">
						<div class="w-11 h-11 bg-[#ffdad6] dark:bg-red-950/60 text-[#ba1a1a] dark:text-red-400 rounded-xl flex items-center justify-center mb-4">
							<span class="material-symbols-outlined text-2xl">delete_sweep</span>
						</div>
						<h3 class="text-lg font-bold text-[#012d1d] dark:text-[#f0fdf4] font-display mb-2">Purge Blank Rows</h3>
						<p class="text-sm text-[#414844] dark:text-[#94a3b8] leading-relaxed flex-1">Quickly purge completely blank rows or rows missing crucial data points to condense file size.</p>
						<a href="#workspace-container" class="mt-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] hover:text-[#1b4332] dark:hover:text-[#2dd4bf] transition-colors">
							<span>Purge Blank Rows</span>
							<span class="material-symbols-outlined text-base">arrow_forward</span>
						</a>
					</div>

					<!-- Tool 4 -->
					<div class="group flex flex-col bg-white dark:bg-[#0e2019] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-2xl p-6 hover:border-[#012d1d] hover:dark:border-[#34d399] hover:shadow-md transition-all duration-200">
						<div class="w-11 h-11 bg-[#ffdcc4] dark:bg-amber-950/60 text-[#5f2f00] dark:text-amber-400 rounded-xl flex items-center justify-center mb-4">
							<span class="material-symbols-outlined text-2xl">view_week</span>
						</div>
						<h3 class="text-lg font-bold text-[#012d1d] dark:text-[#f0fdf4] font-display mb-2">Remove Empty Columns</h3>
						<p class="text-sm text-[#414844] dark:text-[#94a3b8] leading-relaxed flex-1">Strip away redundant, entirely blank columns that clutter your workspace and bloat spreadsheet size.</p>
						<a href="#workspace-container" class="mt-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] hover:text-[#1b4332] dark:hover:text-[#2dd4bf] transition-colors">
							<span>Remove Columns</span>
							<span class="material-symbols-outlined text-base">arrow_forward</span>
						</a>
					</div>

					<!-- Tool 5 -->
					<div class="group flex flex-col bg-white dark:bg-[#0e2019] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-2xl p-6 hover:border-[#012d1d] hover:dark:border-[#34d399] hover:shadow-md transition-all duration-200">
						<div class="w-11 h-11 bg-[#c1ecd4] dark:bg-[#104430] text-[#002114] dark:text-[#34d399] rounded-xl flex items-center justify-center mb-4">
							<span class="material-symbols-outlined text-2xl">format_clear</span>
						</div>
						<h3 class="text-lg font-bold text-[#012d1d] dark:text-[#f0fdf4] font-display mb-2">Trim Whitespace</h3>
						<p class="text-sm text-[#414844] dark:text-[#94a3b8] leading-relaxed flex-1">Remove leading, trailing, and excessive internal spaces from cell values to ensure clean string matching.</p>
						<a href="#workspace-container" class="mt-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] hover:text-[#1b4332] dark:hover:text-[#2dd4bf] transition-colors">
							<span>Trim Whitespace</span>
							<span class="material-symbols-outlined text-base">arrow_forward</span>
						</a>
					</div>

					<!-- Tool 6 -->
					<div class="group flex flex-col bg-white dark:bg-[#0e2019] border border-[#c1c8c2] dark:border-[#1b3b2f] rounded-2xl p-6 hover:border-[#012d1d] hover:dark:border-[#34d399] hover:shadow-md transition-all duration-200">
						<div class="w-11 h-11 bg-[#dde4e6] dark:bg-[#162f25] text-[#161d1f] dark:text-[#34d399] rounded-xl flex items-center justify-center mb-4">
							<span class="material-symbols-outlined text-2xl">fact_check</span>
						</div>
						<h3 class="text-lg font-bold text-[#012d1d] dark:text-[#f0fdf4] font-display mb-2">CSV Validator</h3>
						<p class="text-sm text-[#414844] dark:text-[#94a3b8] leading-relaxed flex-1">Check file structure, encoding, and delimiter consistency before importing data into external systems.</p>
						<a href="#workspace-container" class="mt-5 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] hover:text-[#1b4332] dark:hover:text-[#2dd4bf] transition-colors">
							<span>Validate CSV</span>
							<span class="material-symbols-outlined text-base">arrow_forward</span>
						</a>
					</div>

				</div>
			</div>
		</section>

		<!-- ═══════════════════════════════════════════
		     SECTION 4: USE CASES (Before / After)
		     ═══════════════════════════════════════════ -->
		<section class="py-14 px-4 sm:px-6 border-t border-[#c1c8c2]/40 dark:border-[#1b3b2f]">
			<div class="max-w-7xl mx-auto">

				<div class="text-center mb-10 space-y-2">
					<p class="text-xs font-bold uppercase tracking-widest text-[#3f6653] dark:text-[#34d399]">Real-World Applications</p>
					<h2 class="text-2xl sm:text-3xl font-extrabold text-[#012d1d] dark:text-[#f0fdf4] font-display">Works for Every Team</h2>
					<p class="text-sm text-[#57615c] dark:text-[#94a3b8] max-w-xl mx-auto">From marketing lists to CRM exports, see before & after transformations.</p>
				</div>

				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

					<!-- Marketing Lists -->
					<div class="bg-white dark:bg-[#0e2019] rounded-2xl border border-[#c1c8c2] dark:border-[#1b3b2f] p-6 flex flex-col gap-4">
						<div class="flex items-center gap-3">
							<span class="material-symbols-outlined text-[#012d1d] dark:text-[#34d399] text-2xl">campaign</span>
							<h3 class="text-xl font-bold text-[#012d1d] dark:text-[#f0fdf4] font-display">Marketing Lists</h3>
						</div>
						<p class="text-sm text-[#414844] dark:text-[#94a3b8] leading-relaxed">Consolidate event signups and newsletter lists. Standardize casing, validate emails, and remove duplicates.</p>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
							<div>
								<span class="text-[10px] font-bold uppercase tracking-wider text-[#ba1a1a] dark:text-red-400 block mb-1.5">Before</span>
								<div class="bg-[#fff8f8] dark:bg-red-950/20 rounded-xl p-3 border border-[#ffdad6] dark:border-red-900/40 font-mono text-[11px] text-[#414844] dark:text-[#f0fdf4] overflow-x-auto whitespace-pre leading-relaxed">Name,Email,Company
JOhn dOe,john@example .com,Acme corp
jane smith,jane@example.com,Acme Corp
john doe,JOhn@EXAMPLE.com,Acme Corp</div>
							</div>
							<div>
								<span class="text-[10px] font-bold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] block mb-1.5">After</span>
								<div class="bg-[#f0faf4] dark:bg-[#104430]/30 rounded-xl p-3 border border-[#a5d0b9] dark:border-[#34d399]/30 font-mono text-[11px] text-[#012d1d] dark:text-[#34d399] overflow-x-auto whitespace-pre leading-relaxed">Name,Email,Company
John Doe,john@example.com,Acme Corp
Jane Smith,jane@example.com,Acme Corp</div>
							</div>
						</div>
					</div>

					<!-- CRM Exports -->
					<div class="bg-white dark:bg-[#0e2019] rounded-2xl border border-[#c1c8c2] dark:border-[#1b3b2f] p-6 flex flex-col gap-4">
						<div class="flex items-center gap-3">
							<span class="material-symbols-outlined text-[#012d1d] dark:text-[#34d399] text-2xl">manage_accounts</span>
							<h3 class="text-xl font-bold text-[#012d1d] dark:text-[#f0fdf4] font-display">CRM Exports</h3>
						</div>
						<p class="text-sm text-[#414844] dark:text-[#94a3b8] leading-relaxed">Prepare Salesforce or HubSpot exports for reporting. Normalize date formats and strip HTML from notes.</p>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
							<div>
								<span class="text-[10px] font-bold uppercase tracking-wider text-[#ba1a1a] dark:text-red-400 block mb-1.5">Before</span>
								<div class="bg-[#fff8f8] dark:bg-red-950/20 rounded-xl p-3 border border-[#ffdad6] dark:border-red-900/40 font-mono text-[11px] text-[#414844] dark:text-[#f0fdf4] overflow-x-auto whitespace-pre leading-relaxed">Contact,Last_Touch,Notes
Sarah Jenkins,12/04/23,&lt;p&gt;Called left VM&lt;/p&gt;
Mike T.,2023-04-12,emailed pricing</div>
							</div>
							<div>
								<span class="text-[10px] font-bold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] block mb-1.5">After</span>
								<div class="bg-[#f0faf4] dark:bg-[#104430]/30 rounded-xl p-3 border border-[#a5d0b9] dark:border-[#34d399]/30 font-mono text-[11px] text-[#012d1d] dark:text-[#34d399] overflow-x-auto whitespace-pre leading-relaxed">Contact,Last_Touch,Notes
