---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="CSV Cleaner — Messy CSV? Let's clean it up.">
	<!-- Top Navigation Bar -->
	<Navbar activePage="home" />

	<main class="flex-grow pt-16">
		<!-- HERO SECTION -->
		<section class="max-w-7xl mx-auto px-6 pt-12 pb-16 lg:pt-20 lg:pb-24">
			<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
				<!-- Hero Text -->
				<div class="lg:col-span-5 flex flex-col gap-6">
					<div class="inline-flex items-center gap-2 bg-[#e2e9ec] px-3 py-1 rounded-full w-fit border border-[#c1c8c2]/50">
						<span class="material-symbols-outlined text-sm text-[#012d1d]">shield</span>
						<span class="text-xs font-semibold text-[#012d1d] uppercase tracking-wider">Privacy First • Runs Locally</span>
					</div>

					<h1 class="text-4xl sm:text-5xl font-extrabold text-[#161d1f] font-display leading-tight tracking-tight">
						Messy CSV?<br />
						<span class="text-[#012d1d]">Let’s clean it up.</span>
					</h1>

					<p class="text-lg text-[#414844] font-body leading-relaxed max-w-lg">
						Find what’s wrong, fix it safely, and download clean, import-ready data — without uploading your file to any server.
					</p>

					<div class="flex flex-col sm:flex-row gap-3 pt-2">
						<a href="#upload-section" class="bg-[#012d1d] text-white font-semibold text-xs uppercase tracking-wider px-6 py-3.5 rounded-lg hover:bg-[#1b4332] transition-all shadow-ambient flex items-center justify-center gap-2">
							<span class="material-symbols-outlined text-lg">upload_file</span>
							Clean My CSV
						</a>
						<button id="hero-sample-btn" class="bg-[#d8e2dc] text-[#012d1d] font-semibold text-xs uppercase tracking-wider px-6 py-3.5 rounded-lg hover:bg-[#dde4e6] transition-colors flex items-center justify-center gap-2">
							<span class="material-symbols-outlined text-lg">science</span>
							Try with a sample file
						</button>
					</div>
				</div>

				<!-- Hero Visual (Interactive Data Grid Representation) -->
				<div class="lg:col-span-7">
					<div class="bg-white rounded-xl border border-[#c1c8c2] shadow-ambient overflow-hidden">
						<!-- Mock Header -->
						<div class="bg-[#eef5f7] px-4 py-2.5 border-b border-[#c1c8c2] flex justify-between items-center">
							<div class="flex gap-1.5">
								<div class="w-3 h-3 rounded-full bg-[#d4dbdd]"></div>
								<div class="w-3 h-3 rounded-full bg-[#d4dbdd]"></div>
								<div class="w-3 h-3 rounded-full bg-[#d4dbdd]"></div>
							</div>
							<div class="font-mono text-xs text-[#414844] font-medium">messy_contacts_final.csv</div>
							<div class="flex items-center gap-1 bg-[#ffdad6] text-[#ba1a1a] px-2 py-0.5 rounded-full border border-[#ba1a1a]/20">
								<span class="material-symbols-outlined text-xs">warning</span>
								<span class="text-[10px] font-bold uppercase tracking-wider">12 Issues Detected</span>
							</div>
						</div>

						<!-- Table Preview -->
						<div class="overflow-x-auto">
							<table class="w-full text-left border-collapse font-body text-xs">
								<thead>
									<tr class="bg-[#F1F1EF] text-[#414844] font-mono border-b border-[#c1c8c2]">
										<th class="py-2.5 px-3 font-semibold w-10 text-center">#</th>
										<th class="py-2.5 px-3 font-semibold">First Name</th>
										<th class="py-2.5 px-3 font-semibold">Email</th>
										<th class="py-2.5 px-3 font-semibold">Company</th>
										<th class="py-2.5 px-3 font-semibold">Status</th>
									</tr>
								</thead>
								<tbody class="text-[#161d1f] font-mono">
									<tr class="border-b border-[#c1c8c2]/50 hover:bg-[#F7F9F8] transition-colors">
										<td class="py-2.5 px-3 text-[#717973] text-center">1</td>
										<td class="py-2.5 px-3 font-medium">Sarah</td>
										<td class="py-2.5 px-3">sarah@acme.co</td>
										<td class="py-2.5 px-3">Acme Corp</td>
										<td class="py-2.5 px-3"><span class="bg-[#c1ecd4] text-[#002114] px-2 py-0.5 rounded-full text-[10px] font-bold">Active</span></td>
									</tr>
									<tr class="border-b border-[#c1c8c2]/50 bg-[#ffdad6]/20 relative group">
										<td class="py-2.5 px-3 text-[#717973] text-center">2</td>
										<td class="py-2.5 px-3 border-l-2 border-[#ba1a1a] relative">
											<span class="inline-block bg-[#ffdad6] text-[#ba1a1a] px-1 rounded border border-[#ba1a1a]/30">  John  </span>
											<span class="hidden group-hover:block absolute left-2 -top-8 bg-[#161d1f] text-white text-[10px] px-2 py-1 rounded shadow-lg z-20 whitespace-nowrap">Leading/Trailing Spaces</span>
										</td>
										<td class="py-2.5 px-3">john@smith .com</td>
										<td class="py-2.5 px-3">Smith LLC</td>
										<td class="py-2.5 px-3"><span class="bg-[#dde4e6] text-[#161d1f] px-2 py-0.5 rounded-full text-[10px] font-bold">Pending</span></td>
									</tr>
									<tr class="border-b border-[#c1c8c2]/50 bg-[#e8eff1]/60">
										<td class="py-2.5 px-3 text-[#717973]/50 text-center">3</td>
										<td class="py-2.5 px-3 text-[#ba1a1a]/50 italic" colspan="4">Empty Row Detected</td>
									</tr>
									<tr class="border-b border-[#c1c8c2]/50 bg-[#ffdcc4]/40 group relative">
										<td class="py-2.5 px-3 text-[#717973] text-center">4</td>
										<td class="py-2.5 px-3 border-l-2 border-[#5f2f00]">Sarah</td>
										<td class="py-2.5 px-3">sarah@acme.co</td>
										<td class="py-2.5 px-3">Acme Corp</td>
										<td class="py-2.5 px-3"><span class="bg-[#ffdcc4] text-[#3f1d00] px-2 py-0.5 rounded-full text-[10px] font-bold">Duplicate</span></td>
									</tr>
									<tr class="hover:bg-[#F7F9F8] transition-colors">
										<td class="py-2.5 px-3 text-[#717973] text-center">5</td>
										<td class="py-2.5 px-3">David</td>
										<td class="py-2.5 px-3">david@design.io</td>
										<td class="py-2.5 px-3">Design IO</td>
										<td class="py-2.5 px-3"><span class="bg-[#c1ecd4] text-[#002114] px-2 py-0.5 rounded-full text-[10px] font-bold">Active</span></td>
									</tr>
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- TRUST STRIP -->
		<section class="border-y border-[#c1c8c2]/60 bg-white py-6">
			<div class="max-w-7xl mx-auto px-6">
				<div class="flex flex-col md:flex-row justify-center items-center gap-6 md:gap-12">
					<div class="text-base font-bold text-[#414844] font-display">
						Your file stays on your device.
					</div>
					<div class="flex gap-8 flex-wrap justify-center">
						<div class="flex items-center gap-3">
							<div class="w-10 h-10 rounded-full bg-[#c1ecd4]/50 flex items-center justify-center text-[#012d1d]">
								<span class="material-symbols-outlined">lock</span>
							</div>
							<span class="text-sm font-semibold text-[#161d1f]">100% Private</span>
						</div>
						<div class="flex items-center gap-3">
							<div class="w-10 h-10 rounded-full bg-[#d8e2dc]/50 flex items-center justify-center text-[#012d1d]">
								<span class="material-symbols-outlined">person_off</span>
							</div>
							<span class="text-sm font-semibold text-[#161d1f]">No Signup</span>
						</div>
						<div class="flex items-center gap-3">
							<div class="w-10 h-10 rounded-full bg-[#ffdcc4]/50 flex items-center justify-center text-[#5f2f00]">
								<span class="material-symbols-outlined">bolt</span>
							</div>
							<span class="text-sm font-semibold text-[#161d1f]">Instant Results</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- BENTO GRID: PROBLEM & SOLUTION -->
		<section id="features" class="max-w-7xl mx-auto px-6 py-16">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-extrabold text-[#161d1f] font-display mb-3">Common issues, solved instantly.</h2>
				<p class="text-base text-[#414844] max-w-2xl mx-auto">We identify the most frustrating CSV errors before they break your database imports.</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
				<!-- Card 1: Extra Spaces -->
				<div class="bg-white rounded-xl p-6 border border-[#c1c8c2] shadow-ambient hover:border-[#012d1d] transition-all flex flex-col">
					<div class="flex items-center gap-3 mb-4">
						<div class="w-9 h-9 rounded-full bg-[#ffdad6]/60 flex items-center justify-center text-[#ba1a1a]">
							<span class="material-symbols-outlined text-lg">space_bar</span>
						</div>
						<h3 class="text-lg font-bold text-[#161d1f] font-display">Extra Spaces</h3>
					</div>
					<div class="flex-grow bg-[#e8eff1] rounded-lg p-4 border border-[#c1c8c2]/40 font-mono text-xs flex flex-col justify-center gap-2">
						<div class="flex justify-between items-center text-[#414844]">
							<span>Before</span>
							<span class="bg-[#ffdad6] text-[#ba1a1a] px-2 py-0.5 rounded font-semibold border border-[#ba1a1a]/30">"  John Doe  "</span>
						</div>
						<div class="flex justify-center my-1 text-[#717973]">
							<span class="material-symbols-outlined text-sm">arrow_downward</span>
						</div>
						<div class="flex justify-between items-center text-[#161d1f]">
							<span>After</span>
							<span class="bg-[#c1ecd4] text-[#002114] px-2 py-0.5 rounded font-semibold border border-[#012d1d]/30">"John Doe"</span>
						</div>
					</div>
				</div>

				<!-- Card 2: Duplicate Rows -->
				<div class="bg-white rounded-xl p-6 border border-[#c1c8c2] shadow-ambient hover:border-[#012d1d] transition-all flex flex-col">
					<div class="flex items-center gap-3 mb-4">
						<div class="w-9 h-9 rounded-full bg-[#ffdcc4]/60 flex items-center justify-center text-[#5f2f00]">
							<span class="material-symbols-outlined text-lg">content_copy</span>
						</div>
						<h3 class="text-lg font-bold text-[#161d1f] font-display">Duplicate Rows</h3>
					</div>
					<div class="flex-grow bg-[#e8eff1] rounded-lg p-4 border border-[#c1c8c2]/40 font-mono text-xs flex flex-col justify-center gap-2">
						<div class="bg-white px-3 py-1.5 rounded border border-[#c1c8c2]/50 text-[#161d1f]">1, Sarah, sarah@acme.co</div>
						<div class="bg-[#ffdcc4]/60 text-[#3f1d00] px-3 py-1.5 rounded border border-[#5f2f00]/30 line-through">1, Sarah, sarah@acme.co</div>
						<div class="bg-white px-3 py-1.5 rounded border border-[#c1c8c2]/50 text-[#161d1f]">2, David, david@design.io</div>
					</div>
				</div>

				<!-- Card 3: Empty Rows -->
				<div class="bg-white rounded-xl p-6 border border-[#c1c8c2] shadow-ambient hover:border-[#012d1d] transition-all flex flex-col">
					<div class="flex items-center gap-3 mb-4">
						<div class="w-9 h-9 rounded-full bg-[#d8e2dc] flex items-center justify-center text-[#57615c]">
							<span class="material-symbols-outlined text-lg">delete_sweep</span>
						</div>
						<h3 class="text-lg font-bold text-[#161d1f] font-display">Empty Rows</h3>
					</div>
					<div class="flex-grow bg-[#e8eff1] rounded-lg p-4 border border-[#c1c8c2]/40 font-mono text-xs flex flex-col justify-center gap-2">
						<div class="bg-white px-3 py-1.5 rounded border border-[#c1c8c2]/50 text-[#161d1f]">Data Row 1</div>
						<div class="bg-[#f4fafd] border border-dashed border-[#c1c8c2] h-7 rounded flex items-center justify-center">
							<span class="material-symbols-outlined text-xs text-[#717973]">close</span>
							<span class="text-[10px] text-[#717973] ml-1">Blank line purged</span>
						</div>
						<div class="bg-white px-3 py-1.5 rounded border border-[#c1c8c2]/50 text-[#161d1f]">Data Row 2</div>
					</div>
				</div>
			</div>
		</section>

		<!-- UPLOAD SECTION -->
		<section id="upload-section" class="max-w-4xl mx-auto px-6 py-12 scroll-mt-20">
			<div class="text-center mb-8">
				<h2 class="text-3xl font-extrabold text-[#012d1d] font-display mb-2">Bring your CSV</h2>
				<p class="text-base text-[#414844]">Clean, format, and prepare your data instantly. No servers. No hassle.</p>
				<div class="inline-flex items-center gap-1.5 bg-[#dde4e6] px-3 py-1 rounded-full text-[#012d1d] text-xs font-semibold mt-3">
					<span class="material-symbols-outlined text-sm">lock</span>
					<span>Runs locally in your browser</span>
				</div>
			</div>

			<!-- Drag & Drop Zone -->
			<div id="dropzone" class="relative group cursor-pointer transition-all duration-300">
				<input type="file" id="file-input" accept=".csv,text/csv" class="hidden" />
				<div class="absolute inset-0 bg-[#012d1d]/5 rounded-2xl border-2 border-dashed border-[#012d1d]/30 group-hover:border-[#012d1d] transition-all"></div>
				<div class="relative bg-white/90 backdrop-blur-sm rounded-2xl p-10 lg:p-14 shadow-ambient flex flex-col items-center justify-center gap-6 border border-[#c1c8c2]">
					<div class="w-24 h-24 relative text-[#012d1d]/40 group-hover:text-[#012d1d] transition-colors">
						<span class="material-symbols-outlined text-8xl absolute inset-0 flex items-center justify-center group-hover:scale-105 transition-transform" style="font-variation-settings: 'FILL' 1;">
							description
						</span>
						<span class="material-symbols-outlined text-3xl absolute bottom-0 right-0 bg-white rounded-full p-1 shadow-md group-hover:rotate-12 transition-transform text-[#012d1d]">
							file_download
						</span>
					</div>

					<div class="text-center">
						<p class="text-2xl font-bold text-[#161d1f] font-display mb-1">Drag & Drop your file here</p>
						<p class="text-xs text-[#717973]">CSV files up to 50MB supported</p>
					</div>

					<div class="flex items-center gap-4">
						<button id="browse-btn" class="bg-[#012d1d] text-white px-6 py-2.5 rounded-lg text-xs font-semibold uppercase tracking-wider hover:bg-[#1b4332] shadow-xs transition-all">
							Browse Files
						</button>
						<span class="text-xs text-[#717973]">or</span>
						<button id="sample-dataset-btn" class="bg-[#d8e2dc] text-[#012d1d] px-6 py-2.5 rounded-lg text-xs font-semibold uppercase tracking-wider hover:bg-[#dde4e6] border border-[#c1c8c2]/50 transition-colors">
							Load Sample Dataset
						</button>
					</div>
				</div>
			</div>
		</section>

		<!-- WORKSPACE SECTION -->
		<section id="workspace" class="max-w-7xl mx-auto px-6 py-12 border-t border-[#c1c8c2]/60 scroll-mt-20">
			<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
				<div>
					<div class="flex items-center gap-2">
						<span class="material-symbols-outlined text-2xl text-[#012d1d]">analytics</span>
						<h2 class="text-2xl font-extrabold text-[#012d1d] font-display">Cleaning Workspace</h2>
					</div>
					<p class="text-xs text-[#414844] mt-1">Review diagnosed issues, toggle fixes, and preview results live.</p>
				</div>

				<div class="flex items-center gap-3">
					<button id="reset-workspace-btn" class="text-xs font-semibold uppercase tracking-wider text-[#57615c] hover:text-[#012d1d] px-3 py-1.5 rounded-lg border border-[#c1c8c2] hover:bg-[#e8eff1] transition-colors flex items-center gap-1">
						<span class="material-symbols-outlined text-sm">refresh</span>
						Reset File
					</button>
				</div>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-12 gap-6 settle-animate">
				<!-- Left Panel: Recommended Fixes -->
				<aside class="lg:col-span-3 flex flex-col gap-4">
					<div class="bg-white rounded-xl p-5 border border-[#c1c8c2] shadow-ambient">
						<h3 class="text-base font-bold text-[#012d1d] font-display mb-4">Recommended Fixes</h3>

						<div class="space-y-4">
							<!-- Safe Fixes -->
							<div>
								<h4 class="text-[11px] font-semibold uppercase tracking-wider text-[#414844] mb-2 flex items-center gap-2">
									<span class="w-2 h-2 rounded-full bg-[#012d1d]"></span> Safe to apply
								</h4>

								<!-- Fix 1: Trim Whitespace -->
								<div class="bg-[#f4fafd] rounded-lg p-3 border border-[#c1c8c2]/50 flex items-center justify-between mb-2.5 hover:border-[#012d1d] transition-colors">
									<div>
										<p class="text-xs font-semibold text-[#161d1f]">Trim whitespace</p>
										<p id="fix-trim-count" class="text-[11px] text-[#414844]">34 cells affected</p>
									</div>
									<label class="relative inline-flex items-center cursor-pointer">
										<input type="checkbox" id="toggle-trim" class="sr-only peer" checked />
										<div class="w-9 h-5 bg-[#dde4e6] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[#012d1d]"></div>
									</label>
								</div>

								<!-- Fix 2: Remove Empty Rows -->
								<div class="bg-[#f4fafd] rounded-lg p-3 border border-[#c1c8c2]/50 flex items-center justify-between hover:border-[#012d1d] transition-colors">
									<div>
										<p class="text-xs font-semibold text-[#161d1f]">Remove empty rows</p>
										<p id="fix-empty-count" class="text-[11px] text-[#414844]">12 rows</p>
									</div>
									<label class="relative inline-flex items-center cursor-pointer">
										<input type="checkbox" id="toggle-empty" class="sr-only peer" checked />
										<div class="w-9 h-5 bg-[#dde4e6] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[#012d1d]"></div>
									</label>
								</div>
							</div>

							<!-- Review Fixes -->
							<div class="pt-3 border-t border-[#c1c8c2]/40">
								<h4 class="text-[11px] font-semibold uppercase tracking-wider text-[#414844] mb-2 flex items-center gap-2">
									<span class="w-2 h-2 rounded-full bg-[#e39454]"></span> Needs Review
								</h4>
								<div class="bg-[#f4fafd] rounded-lg p-3 border border-[#c1c8c2]/50 flex items-center justify-between">
									<div>
										<p class="text-xs font-semibold text-[#161d1f]">Duplicate Entries</p>
										<p id="fix-duplicate-count" class="text-[11px] text-[#414844]">5 pairs found</p>
									</div>
									<label class="relative inline-flex items-center cursor-pointer">
										<input type="checkbox" id="toggle-duplicates" class="sr-only peer" checked />
										<div class="w-9 h-5 bg-[#dde4e6] peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-[#012d1d]"></div>
									</label>
								</div>
							</div>
						</div>
					</div>
				</aside>

				<!-- Center Panel: Data Grid -->
				<div class="lg:col-span-6 flex flex-col bg-white rounded-xl border border-[#c1c8c2] shadow-ambient overflow-hidden min-h-[420px]">
					<!-- Grid Toolbar -->
					<div class="p-3 border-b border-[#c1c8c2] flex items-center justify-between bg-[#f4fafd]/50">
						<div class="flex items-center gap-3">
							<span class="text-xs font-semibold uppercase tracking-wider text-[#414844]">View:</span>
							<div class="flex bg-[#dde4e6] rounded-lg p-[2px]">
								<button id="view-original-btn" class="px-3 py-1 text-xs font-semibold rounded-md bg-white text-[#012d1d] shadow-xs transition-all">Original</button>
								<button id="view-preview-btn" class="px-3 py-1 text-xs font-semibold rounded-md text-[#414844] hover:text-[#012d1d] transition-all">Preview Fixes</button>
							</div>
						</div>
						<div class="text-xs font-mono text-[#414844]">
							<span id="showing-rows-text">Showing 1-10 rows</span>
						</div>
					</div>

					<!-- Table Container -->
					<div class="flex-1 overflow-auto max-h-[460px]">
						<table class="w-full text-left border-collapse min-w-[500px]">
							<thead class="sticky top-0 bg-[#F1F1EF] z-10 shadow-xs">
								<tr id="table-head-row" class="font-mono text-xs text-[#414844] border-b border-[#c1c8c2]">
									<th class="p-2 pl-3 w-10 text-center">#</th>
									<!-- Dynamic Headers -->
								</tr>
							</thead>
							<tbody id="table-body" class="font-mono text-xs text-[#161d1f]">
								<!-- Dynamic Rows -->
							</tbody>
						</table>
					</div>
				</div>

				<!-- Right Panel: Changes Summary -->
				<aside class="lg:col-span-3 flex flex-col gap-4">
					<div class="bg-white rounded-xl p-5 border border-[#c1c8c2] shadow-ambient flex flex-col h-full justify-between">
						<div>
							<h3 class="text-base font-bold text-[#012d1d] font-display mb-1">Changes Ready</h3>
							<p class="text-xs text-[#414844] mb-4">Review summary before exporting.</p>

							<div class="bg-[#f4fafd] rounded-lg p-5 text-center mb-4 border border-[#c1c8c2]/50">
								<span id="summary-total-fixes" class="text-4xl font-extrabold text-[#012d1d] font-display block">427</span>
								<span class="text-xs font-semibold uppercase tracking-wider text-[#414844] block mt-1">Total Fixes Identified</span>
							</div>

							<div class="space-y-3 font-body">
								<div class="flex justify-between items-center text-xs">
									<span class="text-[#414844]">Trimmed cells</span>
									<span id="summary-trimmed-count" class="font-mono font-bold text-[#161d1f]">410</span>
								</div>
								<div class="flex justify-between items-center text-xs">
									<span class="text-[#414844]">Empty rows removed</span>
									<span id="summary-empty-count" class="font-mono font-bold text-[#161d1f]">12</span>
								</div>
								<div class="flex justify-between items-center text-xs text-[#5f2f00]">
									<span>Duplicates removed</span>
									<span id="summary-dup-count" class="font-mono font-bold">5</span>
								</div>
							</div>
						</div>

						<div class="pt-6 border-t border-[#c1c8c2]/40 mt-6">
							<button id="apply-export-btn" class="w-full bg-[#012d1d] text-white font-semibold text-xs uppercase tracking-wider py-3 rounded-lg hover:bg-[#1b4332] shadow-ambient transition-all flex items-center justify-center gap-2">
								<span class="material-symbols-outlined text-lg">download</span>
								Apply & Export CSV
							</button>
						</div>
					</div>
				</aside>
			</div>
		</section>

		<!-- SUCCESS EXPORT MODAL -->
		<div id="success-modal" class="fixed inset-0 bg-[#161d1f]/60 backdrop-blur-xs z-50 flex items-center justify-center p-4 hidden">
			<div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-[#c1c8c2] text-center space-y-4 animate-in fade-in zoom-in duration-300">
				<div class="w-16 h-16 rounded-full bg-[#c1ecd4] text-[#012d1d] mx-auto flex items-center justify-center">
					<span class="material-symbols-outlined text-4xl">check_circle</span>
				</div>

				<h3 class="text-2xl font-bold text-[#012d1d] font-display">Your CSV is Clean!</h3>

				<div class="bg-[#eef5f7] rounded-xl p-4 text-xs space-y-2 border border-[#c1c8c2]/50">
					<div class="flex justify-between text-[#414844]">
						<span>New Health Score:</span>
						<span class="font-bold text-[#012d1d]">100 / 100</span>
					</div>
					<div class="flex justify-between text-[#414844]">
						<span>Fixes Applied:</span>
						<span id="modal-applied-fixes" class="font-mono font-bold text-[#161d1f]">427</span>
					</div>
					<div class="flex justify-between text-[#414844]">
						<span>Privacy:</span>
						<span class="font-semibold text-[#002114] bg-[#c1ecd4] px-1.5 py-0.5 rounded">100% Local</span>
					</div>
				</div>

				<div class="flex flex-col gap-2 pt-2">
					<button id="modal-download-again" class="bg-[#012d1d] text-white font-semibold text-xs uppercase tracking-wider py-3 rounded-lg hover:bg-[#1b4332] transition-colors flex items-center justify-center gap-2">
						<span class="material-symbols-outlined text-lg">download</span>
						Download Cleaned CSV Again
					</button>
					<button id="modal-close-btn" class="bg-transparent text-[#57615c] hover:text-[#012d1d] text-xs font-semibold uppercase tracking-wider py-2">
						Close & Continue
					</button>
				</div>
			</div>
		</div>
	</main>

	<!-- Footer -->
	<footer class="w-full py-8 px-6 flex flex-col md:flex-row justify-between items-center gap-4 bg-white border-t border-[#c1c8c2]">
		<div class="text-[#012d1d] font-bold font-display text-lg flex items-center gap-2">
			<span class="material-symbols-outlined filled text-xl">cleaning_services</span>
			<span>CSV Cleaner</span>
		</div>
		<div class="text-xs text-[#414844] text-center">
			© 2026 CSV Cleaner. Privacy First. Runs locally in your browser.
		</div>
		<nav class="flex gap-4 text-xs font-semibold uppercase tracking-wider text-[#414844]">
			<a href="/features" class="hover:text-[#012d1d] transition-colors">Features</a>
			<a href="/how-it-works" class="hover:text-[#012d1d] transition-colors">How It Works</a>
			<a href="/upload" class="hover:text-[#012d1d] transition-colors">Upload</a>
		</nav>
	</footer>

	<!-- INTERACTIVE CLIENT-SIDE JAVASCRIPT ENGINE -->
	<script is:inline>
		// Sample CSV Dataset
		const SAMPLE_CSV = `First Name,Email,Company,Status,Location
Sarah  ,sarah@acme.co,Acme Corp,Active, New York 
  John  ,john@smith .com,Smith LLC,Pending,  Chicago
,,,,
Sarah,sarah@acme.co,Acme Corp,Active,New York
David  ,david@design.io ,Design IO,Active, San Francisco
  Emily,emily@tech.com,Tech Solutions,Pending,Boston  
,,,,
  Alex,alex@global.org ,Global Org,Active, London 
David,david@design.io,Design IO,Active,San Francisco`;

		let currentRawCsv = SAMPLE_CSV;
		let parsedHeaders = [];
		let parsedRows = []; // array of array of strings
		let activeMode = 'original'; // 'original' | 'preview'

		// Toggles
		let toggleTrim = true;
		let toggleEmpty = true;
		let toggleDuplicates = true;

		// Issue Tracking Metrics
		let trimCellCount = 0;
		let emptyRowCount = 0;
		let duplicateCount = 0;

		// Initialize
		document.addEventListener('DOMContentLoaded', () => {
			setupEventListeners();
			parseAndLoadCsv(SAMPLE_CSV);
		});

		function setupEventListeners() {
			// Hero Sample Button
			document.getElementById('hero-sample-btn')?.addEventListener('click', () => {
				parseAndLoadCsv(SAMPLE_CSV);
				scrollToWorkspace();
			});

			// Sample Dataset Button in Upload Zone
			document.getElementById('sample-dataset-btn')?.addEventListener('click', () => {
				parseAndLoadCsv(SAMPLE_CSV);
				scrollToWorkspace();
			});

			// Browse Files
			const fileInput = document.getElementById('file-input');
			const browseBtn = document.getElementById('browse-btn');
			const dropzone = document.getElementById('dropzone');

			browseBtn?.addEventListener('click', (e) => {
				e.stopPropagation();
				fileInput?.click();
			});

			dropzone?.addEventListener('click', () => {
				fileInput?.click();
			});

			fileInput?.addEventListener('change', (e) => {
				const file = e.target.files[0];
				if (file) {
					readUserFile(file);
				}
			});

			// Drag & Drop
			['dragenter', 'dragover'].forEach(name => {
				dropzone?.addEventListener(name, (e) => {
					e.preventDefault();
					e.stopPropagation();
					dropzone.classList.add('border-[#012d1d]');
				});
			});

			['dragleave', 'drop'].forEach(name => {
				dropzone?.addEventListener(name, (e) => {
					e.preventDefault();
					e.stopPropagation();
					dropzone.classList.remove('border-[#012d1d]');
				});
			});

			dropzone?.addEventListener('drop', (e) => {
				const files = e.dataTransfer.files;
				if (files.length > 0) {
					readUserFile(files[0]);
				}
			});

			// Workspace Toggles
			document.getElementById('toggle-trim')?.addEventListener('change', (e) => {
				toggleTrim = e.target.checked;
				renderTable();
			});

			document.getElementById('toggle-empty')?.addEventListener('change', (e) => {
				toggleEmpty = e.target.checked;
				renderTable();
			});

			document.getElementById('toggle-duplicates')?.addEventListener('change', (e) => {
				toggleDuplicates = e.target.checked;
				renderTable();
			});

			// View Mode Buttons
			const origBtn = document.getElementById('view-original-btn');
			const prevBtn = document.getElementById('view-preview-btn');

			origBtn?.addEventListener('click', () => {
				activeMode = 'original';
				origBtn.className = "px-3 py-1 text-xs font-semibold rounded-md bg-white text-[#012d1d] shadow-xs transition-all";
				prevBtn.className = "px-3 py-1 text-xs font-semibold rounded-md text-[#414844] hover:text-[#012d1d] transition-all";
				renderTable();
			});

			prevBtn?.addEventListener('click', () => {
				activeMode = 'preview';
				prevBtn.className = "px-3 py-1 text-xs font-semibold rounded-md bg-white text-[#012d1d] shadow-xs transition-all";
				origBtn.className = "px-3 py-1 text-xs font-semibold rounded-md text-[#414844] hover:text-[#012d1d] transition-all";
				renderTable();
			});

			// Reset Workspace
			document.getElementById('reset-workspace-btn')?.addEventListener('click', () => {
				parseAndLoadCsv(SAMPLE_CSV);
			});

			// Apply & Export CSV
			document.getElementById('apply-export-btn')?.addEventListener('click', () => {
				exportCleanedCsv();
			});

			// Modal Buttons
			document.getElementById('modal-download-again')?.addEventListener('click', () => {
				exportCleanedCsv();
			});

			document.getElementById('modal-close-btn')?.addEventListener('click', () => {
				document.getElementById('success-modal')?.classList.add('hidden');
			});
		}

		function readUserFile(file) {
			const reader = new FileReader();
			reader.onload = (e) => {
				const text = e.target.result;
				parseAndLoadCsv(text);
				scrollToWorkspace();
			};
			reader.readAsText(file);
		}

		function scrollToWorkspace() {
			const workspace = document.getElementById('workspace');
			if (workspace) {
				workspace.scrollIntoView({ behavior: 'smooth' });
			}
		}

		function parseCsvText(text) {
			const lines = text.split(/\r?\n/);
			if (lines.length === 0) return { headers: [], rows: [] };

			const headers = lines[0].split(',').map(h => h.trim());
			const rows = [];

			for (let i = 1; i < lines.length; i++) {
				const line = lines[i];
				if (line === undefined) continue;
				const cells = line.split(',');
				rows.push(cells);
			}

			return { headers, rows };
		}

		function parseAndLoadCsv(text) {
			currentRawCsv = text;
			const { headers, rows } = parseCsvText(text);
			parsedHeaders = headers;
			parsedRows = rows;

			analyzeIssues();
			renderTable();
		}

		function analyzeIssues() {
			trimCellCount = 0;
			emptyRowCount = 0;
			duplicateCount = 0;
			const seenRowStrings = new Set();

			parsedRows.forEach((row) => {
				// Check empty row
				const isEmpty = row.every(cell => !cell || cell.trim() === '');
				if (isEmpty) {
					emptyRowCount++;
					return;
				}

				// Check trimmed cells
				row.forEach(cell => {
					if (cell && cell !== cell.trim()) {
						trimCellCount++;
					}
				});

				// Check duplicates
				const rowStr = row.map(c => c.trim()).join('|');
				if (seenRowStrings.has(rowStr)) {
					duplicateCount++;
				} else {
					seenRowStrings.add(rowStr);
				}
			});

			// Update UI indicators
			document.getElementById('fix-trim-count').textContent = `${trimCellCount} cells affected`;
			document.getElementById('fix-empty-count').textContent = `${emptyRowCount} rows`;
			document.getElementById('fix-duplicate-count').textContent = `${duplicateCount} pairs found`;

			const totalFixes = trimCellCount + emptyRowCount + duplicateCount;
			document.getElementById('summary-total-fixes').textContent = totalFixes;
			document.getElementById('summary-trimmed-count').textContent = trimCellCount;
			document.getElementById('summary-empty-count').textContent = emptyRowCount;
			document.getElementById('summary-dup-count').textContent = duplicateCount;
			document.getElementById('modal-applied-fixes').textContent = totalFixes;

			// Health Score calculation
			const totalItems = parsedRows.length || 1;
			const healthScore = Math.max(10, Math.min(100, Math.round(100 - (totalFixes / (totalItems * 2)) * 100)));
			
			document.getElementById('header-health-score').textContent = `${healthScore}/100`;
			const circle = document.getElementById('header-health-circle');
			if (circle) {
				circle.setAttribute('stroke-dasharray', `${healthScore}, 100`);
			}
		}

		function renderTable() {
			const tableHead = document.getElementById('table-head-row');
			const tableBody = document.getElementById('table-body');
			if (!tableHead || !tableBody) return;

			// Render Headers
			tableHead.innerHTML = '<th class="p-2 pl-3 w-10 text-center">#</th>' + 
				parsedHeaders.map(h => `<th class="p-2 font-semibold">${escapeHtml(h)}</th>`).join('');

			// Process Rows
			const seenRowStrings = new Set();
			let visibleIndex = 1;
			let rowsHtml = '';

			parsedRows.forEach((row, rawIdx) => {
				const isEmpty = row.every(cell => !cell || cell.trim() === '');
				const rowStr = row.map(c => (c || '').trim()).join('|');
				const isDuplicate = seenRowStrings.has(rowStr);
				
				if (!isEmpty) {
					seenRowStrings.add(rowStr);
				}

				// Filtering for Preview Mode
				if (activeMode === 'preview') {
					if (toggleEmpty && isEmpty) return; // Hide empty rows
					if (toggleDuplicates && isDuplicate) return; // Hide duplicate rows
				}

				// Styling rows
				let rowClass = "hover:bg-[#F7F9F8] border-b border-[#c1c8c2]/30 transition-colors";
				if (isEmpty) {
					rowClass = "bg-[#ffdad6]/20 border-b border-[#c1c8c2]/30";
				} else if (isDuplicate) {
					rowClass = "bg-[#ffdcc4]/30 border-b border-[#c1c8c2]/30";
				}

				rowsHtml += `<tr class="${rowClass}">`;
				rowsHtml += `<td class="p-2 pl-3 text-center text-[#717973] text-[11px]">${visibleIndex++}</td>`;

				if (isEmpty) {
					rowsHtml += `<td class="p-2 text-[#ba1a1a]/60 italic font-mono" colspan="${parsedHeaders.length}">[ Empty Blank Row ]</td>`;
				} else {
					row.forEach((cellRaw) => {
						const cell = cellRaw || '';
						const hasWhitespace = cell !== cell.trim();
						let displayValue = cell;

						if (activeMode === 'preview' && toggleTrim && hasWhitespace) {
							displayValue = cell.trim();
						}

						if (activeMode === 'original' && hasWhitespace) {
							rowsHtml += `<td class="p-2 relative bg-[#ffdad6]/20 font-mono">
								<span class="w-1.5 h-1.5 rounded-full bg-[#ba1a1a] inline-block mr-1"></span>
								<span class="underline decoration-dotted decoration-[#ba1a1a]">${escapeHtml(displayValue)}</span>
							</td>`;
						} else if (cell.toLowerCase() === 'active') {
							rowsHtml += `<td class="p-2"><span class="bg-[#c1ecd4] text-[#002114] px-2 py-0.5 rounded-full text-[10px] font-bold">Active</span></td>`;
						} else if (cell.toLowerCase() === 'pending') {
							rowsHtml += `<td class="p-2"><span class="bg-[#dde4e6] text-[#161d1f] px-2 py-0.5 rounded-full text-[10px] font-bold">Pending</span></td>`;
						} else {
							rowsHtml += `<td class="p-2 font-mono text-[#161d1f]">${escapeHtml(displayValue)}</td>`;
						}
					});
				}

				rowsHtml += `</tr>`;
			});

			tableBody.innerHTML = rowsHtml;
			document.getElementById('showing-rows-text').textContent = `Showing 1-${visibleIndex - 1} of ${parsedRows.length} rows`;
		}

		function exportCleanedCsv() {
			let outputRows = [];
			const seen = new Set();

			// Add Headers
			outputRows.push(parsedHeaders.map(h => `"${h.replace(/"/g, '""')}"`).join(','));

			parsedRows.forEach(row => {
				const isEmpty = row.every(cell => !cell || cell.trim() === '');
				if (toggleEmpty && isEmpty) return;

				const cleanedRow = row.map(cell => (toggleTrim ? (cell || '').trim() : (cell || '')));
				const rowStr = cleanedRow.join('|');

				if (toggleDuplicates && seen.has(rowStr)) return;
				seen.add(rowStr);

				outputRows.push(cleanedRow.map(c => `"${c.replace(/"/g, '""')}"`).join(','));
			});

			const csvContent = outputRows.join('\n');
			const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
			const url = URL.createObjectURL(blob);

			const link = document.createElement('a');
			link.setAttribute('href', url);
			link.setAttribute('download', 'cleaned_data.csv');
			document.body.appendChild(link);
			link.click();
			document.body.removeChild(link);

			// Show Success Modal
			document.getElementById('success-modal')?.classList.remove('hidden');
		}

		function escapeHtml(str) {
			return String(str)
				.replace(/&/g, '&amp;')
				.replace(/</g, '&lt;')
				.replace(/>/g, '&gt;')
				.replace(/"/g, '&quot;');
		}
	</script>
</Layout>
