---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="How It Works — CSV Cleaner">
	<Navbar activePage="how-it-works" showHealthBadge={false} />

	<main class="flex-grow pt-20">
		<!-- Hero Section -->
		<section class="max-w-4xl mx-auto px-6 py-12 text-center">
			<h1 class="text-4xl sm:text-5xl font-extrabold text-[#012d1d] font-display mb-4">
				Clean data in simple, transparent steps.
			</h1>
			<p class="text-lg text-[#414844] font-body max-w-2xl mx-auto">
				A botanical precision approach to data management. Calm, clear, and perfectly organized.
			</p>
		</section>

		<!-- Timeline Section -->
		<section class="max-w-5xl mx-auto px-6 py-8 relative">
			<div class="space-y-12">
				<!-- Step 1 -->
				<div class="flex flex-col md:flex-row items-center gap-8 bg-white p-6 rounded-2xl border border-[#c1c8c2] shadow-ambient">
					<div class="w-full md:w-1/2">
						<div class="bg-[#f4fafd] p-8 rounded-xl border border-dashed border-[#012d1d]/30 text-center">
							<span class="material-symbols-outlined text-6xl text-[#012d1d] mb-2">upload_file</span>
							<p class="text-sm font-semibold text-[#161d1f]">Select or Drag & Drop File</p>
							<p class="text-xs text-[#717973]">CSV, TSV, or TXT up to 50MB</p>
						</div>
					</div>
					<div class="w-full md:w-1/2">
						<div class="inline-block bg-[#1b4332] text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-3">Step 01</div>
						<h3 class="text-2xl font-bold text-[#012d1d] font-display mb-2">Bring Your CSV Data</h3>
						<p class="text-sm text-[#414844] leading-relaxed">
							Simply drop your CSV or spreadsheet file into the browser workspace. The file is read directly in your browser without uploading to any remote cloud server.
						</p>
					</div>
				</div>

				<!-- Step 2 -->
				<div class="flex flex-col md:flex-row-reverse items-center gap-8 bg-white p-6 rounded-2xl border border-[#c1c8c2] shadow-ambient">
					<div class="w-full md:w-1/2">
						<div class="bg-[#f4fafd] p-6 rounded-xl border border-[#c1c8c2] space-y-2 font-mono text-xs">
							<div class="flex items-center justify-between text-[#012d1d] font-bold pb-2 border-b border-[#c1c8c2]">
								<span>Scanning Diagnostics...</span>
								<span class="material-symbols-outlined text-sm animate-spin">sync</span>
							</div>
							<div class="flex justify-between text-[#414844]"><span>Whitespace Cells:</span> <span class="font-bold text-[#ba1a1a]">34 found</span></div>
							<div class="flex justify-between text-[#414844]"><span>Empty Blank Lines:</span> <span class="font-bold text-[#ba1a1a]">12 found</span></div>
							<div class="flex justify-between text-[#414844]"><span>Duplicate Records:</span> <span class="font-bold text-[#5f2f00]">5 pairs found</span></div>
						</div>
					</div>
					<div class="w-full md:w-1/2">
						<div class="inline-block bg-[#1b4332] text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-3">Step 02</div>
						<h3 class="text-2xl font-bold text-[#012d1d] font-display mb-2">Instant Automated Analysis</h3>
						<p class="text-sm text-[#414844] leading-relaxed">
							Our client-side engine scans every row and column, detecting leading/trailing spaces, empty lines, duplicate rows, and structural syntax errors in milliseconds.
						</p>
					</div>
				</div>

				<!-- Step 3 -->
				<div class="flex flex-col md:flex-row items-center gap-8 bg-white p-6 rounded-2xl border border-[#c1c8c2] shadow-ambient">
					<div class="w-full md:w-1/2">
						<div class="bg-[#f4fafd] p-6 rounded-xl border border-[#c1c8c2] space-y-3">
							<div class="flex items-center justify-between p-2.5 bg-white rounded border border-[#c1c8c2]">
								<span class="text-xs font-semibold text-[#161d1f]">Trim Whitespace</span>
								<span class="text-xs font-bold text-[#002114] bg-[#c1ecd4] px-2 py-0.5 rounded">Enabled</span>
							</div>
							<div class="flex items-center justify-between p-2.5 bg-white rounded border border-[#c1c8c2]">
								<span class="text-xs font-semibold text-[#161d1f]">Remove Blank Lines</span>
								<span class="text-xs font-bold text-[#002114] bg-[#c1ecd4] px-2 py-0.5 rounded">Enabled</span>
							</div>
						</div>
					</div>
					<div class="w-full md:w-1/2">
						<div class="inline-block bg-[#1b4332] text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-3">Step 03</div>
						<h3 class="text-2xl font-bold text-[#012d1d] font-display mb-2">Review & Select Fixes</h3>
						<p class="text-sm text-[#414844] leading-relaxed">
							Review categorized recommendations ("Safe to apply" vs "Needs Review") and customize exactly which rules to execute.
						</p>
					</div>
				</div>

				<!-- Step 4 -->
				<div class="flex flex-col md:flex-row-reverse items-center gap-8 bg-white p-6 rounded-2xl border border-[#c1c8c2] shadow-ambient">
					<div class="w-full md:w-1/2">
						<div class="bg-[#f4fafd] p-6 rounded-xl border border-[#c1c8c2] text-center space-y-2">
							<span class="material-symbols-outlined text-5xl text-[#012d1d]">check_circle</span>
							<p class="text-sm font-bold text-[#012d1d]">CSV Health Score: 100/100</p>
							<p class="text-xs text-[#414844]">File ready for database import</p>
						</div>
					</div>
					<div class="w-full md:w-1/2">
						<div class="inline-block bg-[#1b4332] text-white text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full mb-3">Step 04</div>
						<h3 class="text-2xl font-bold text-[#012d1d] font-display mb-2">Export Cleaned CSV</h3>
						<p class="text-sm text-[#414844] leading-relaxed">
							Click "Apply & Export" to download your pristine, perfectly structured CSV file directly to your downloads folder.
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Final CTA -->
		<section class="py-16 px-6 text-center bg-[#e8eff1] mt-12">
			<div class="max-w-xl mx-auto">
				<h2 class="text-3xl font-bold text-[#012d1d] font-display mb-3">Start Cleaning in Seconds</h2>
				<p class="text-sm text-[#414844] mb-6">No installation required. Works in Chrome, Firefox, Safari, and Edge.</p>
				<a href="/upload" class="inline-block bg-[#012d1d] text-white text-xs font-semibold uppercase tracking-wider px-8 py-4 rounded-lg hover:bg-[#1b4332] shadow-ambient transition-all">
					Try It Now Free
				</a>
			</div>
		</section>
	</main>

	<!-- Footer -->
	<footer class="w-full py-8 px-6 flex flex-col md:flex-row justify-between items-center gap-4 bg-white border-t border-[#c1c8c2]">
		<div class="text-[#012d1d] font-bold font-display text-lg flex items-center gap-2">
			<span class="material-symbols-outlined filled text-xl">cleaning_services</span>
			<span>CSV Cleaner</span>
		</div>
		<div class="text-xs text-[#414844] text-center">
			© 2026 CSV Cleaner. Privacy First. Runs locally in your browser.
		</div>
		<nav class="flex gap-4 text-xs font-semibold uppercase tracking-wider text-[#414844]">
			<a href="/features" class="hover:text-[#012d1d] transition-colors">Features</a>
			<a href="/how-it-works" class="hover:text-[#012d1d] transition-colors">How It Works</a>
			<a href="/upload" class="hover:text-[#012d1d] transition-colors">Upload</a>
		</nav>
	</footer>
</Layout>
