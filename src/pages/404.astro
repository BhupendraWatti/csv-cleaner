---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
---

<Layout title="404 — Page Not Found | CSV Cleaner">
	<Navbar showHealthBadge={false} />

	<main class="flex-grow pt-28 bg-[#f4fafd] min-h-screen flex items-center justify-center px-6">
		<div class="max-w-md w-full text-center bg-white rounded-2xl p-8 border border-[#c1c8c2] shadow-ambient flex flex-col gap-4">
			<div class="size-16 rounded-full bg-[#ffdad6] text-[#ba1a1a] mx-auto flex items-center justify-center">
				<span class="material-symbols-outlined text-4xl">search_off</span>
			</div>

			<h1 class="text-3xl font-extrabold text-[#161d1f] font-display">404 — Page Not Found</h1>
			<p class="text-sm text-[#414844]">
				The page or route you are looking for does not exist or has been moved.
			</p>

			<div class="pt-4">
				<a
					href="/"
					class="inline-flex items-center gap-2 bg-[#012d1d] text-white text-xs font-semibold uppercase tracking-wider px-6 py-3 rounded-lg hover:bg-[#1b4332] shadow-ambient transition-all"
				>
					<span class="material-symbols-outlined text-base">home</span>
					Return to CSV Cleaner Home
				</a>
			</div>
		</div>
	</main>
</Layout>
