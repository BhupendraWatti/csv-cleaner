---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import CSVCleaner from '../components/CSVCleaner';
---

<Layout title="Upload & Clean — CSV Cleaner">
	<Navbar activePage="home" />

	<main class="flex-grow pt-20 bg-[#f4fafd] dark:bg-[#06120e] min-h-screen transition-colors duration-200">
		<section class="max-w-7xl mx-auto px-6 py-6 space-y-8">
			<CSVCleaner client:only="react" />
		</section>
	</main>
</Layout>
