---
interface Props {
	activePage?: 'home' | 'features' | 'how-it-works' | 'upload' | 'workspace';
	showHealthBadge?: boolean;
}

const { activePage, showHealthBadge = true } = Astro.props;

const navItems = [
	{ name: 'Cleaner Tool', href: '/#workspace-container', id: 'home' },
	{ name: 'Features', href: '/features', id: 'features' },
	{ name: 'How It Works', href: '/how-it-works', id: 'how-it-works' },
];
---

<header class="fixed top-0 w-full z-50 flex justify-between items-center px-6 py-3 bg-[#f4fafd]/90 backdrop-blur-md border-b border-[#c1c8c2]">
	<div class="flex items-center gap-6">
		<a href="/" class="flex items-center gap-2 text-[#012d1d] font-bold text-xl font-display">
			<span class="material-symbols-outlined filled text-[#012d1d] text-2xl">cleaning_services</span>
			<span>CSV Cleaner</span>
		</a>
		<nav class="hidden md:flex items-center gap-5">
			{navItems.map((item) => {
				const active = activePage === item.id;
				return (
					<a
						href={item.href}
						class={active 
							? "text-[#012d1d] border-b-2 border-[#012d1d] pb-0.5 text-xs font-semibold uppercase tracking-wider transition-all" 
							: "text-[#414844] hover:text-[#012d1d] border-b-2 border-transparent pb-0.5 text-xs font-semibold uppercase tracking-wider transition-all"
						}
					>
						{item.name}
					</a>
				);
			})}
		</nav>
	</div>

	<div class="flex items-center gap-4">
		{showHealthBadge && (
			<div id="header-health-badge" aria-live="polite" aria-label="Dataset health score loading" class="flex items-center gap-2 px-3 py-1 bg-[#e8eff1] rounded-full border border-[#c1c8c2]/50 shadow-xs">
				<div class="relative w-6 h-6 flex items-center justify-center">
					<svg class="w-6 h-6 -rotate-90" viewBox="0 0 36 36">
						<path class="text-[#dde4e6]" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-dasharray="100, 100" stroke-width="3.5"></path>
						<path id="header-health-circle" class="text-[#012d1d] transition-all duration-700" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" fill="none" stroke="currentColor" stroke-dasharray="0, 100" stroke-width="3.5"></path>
					</svg>
				</div>
				<span class="text-xs font-semibold text-[#414844] uppercase tracking-wider">Health:</span>
				<span id="header-health-score" class="text-sm font-bold text-[#012d1d]">--/100</span>
				<span id="header-health-icon" class="material-symbols-outlined text-[#012d1d] text-base">pending</span>
			</div>
		)}

		<a href="/#workspace-container" class="bg-[#012d1d] text-white text-xs font-semibold uppercase tracking-wider px-4 py-2 rounded-lg hover:bg-[#1b4332] transition-colors inline-block shadow-xs">
			Clean My CSV
		</a>
	</div>
</header>
