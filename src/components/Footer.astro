---
interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<footer class={`w-full bg-[#e8eff1] dark:bg-[#07130e] border-t border-[#c1c8c2] dark:border-[#1b3b2f] mt-auto font-body text-sm text-[#012d1d] dark:text-[#f0fdf4] pb-28 lg:pb-12 transition-colors duration-200 ${className}`}>
	<div class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-6">
		<!-- Main Footer Content Grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-8 mb-10">
			<!-- Brand Column -->
			<div class="sm:col-span-2 md:col-span-2 flex flex-col gap-3">
				<a href="/" class="flex items-center gap-2 font-display text-xl font-extrabold text-[#012d1d] dark:text-[#f0fdf4]">
					<span class="material-symbols-outlined text-2xl text-[#012d1d] dark:text-[#34d399]" style="font-variation-settings: 'FILL' 1;">cleaning_services</span>
					<span>CSV Cleaner</span>
				</a>
				<p class="text-[#57615c] dark:text-[#94a3b8] text-sm max-w-sm leading-relaxed">
					Fast, 100% private, client-side spreadsheet sanitizer. Your files are processed locally in your browser and never touch external servers.
				</p>
				<div class="flex flex-wrap items-center gap-2 pt-2">
					<span class="inline-flex items-center gap-1.5 bg-white dark:bg-[#0e2019] px-3 py-1 rounded-full text-xs font-semibold text-[#012d1d] dark:text-[#34d399] border border-[#c1c8c2]/50 dark:border-[#1b3b2f]">
						<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">shield</span>
						100% Client-Side
					</span>
					<span class="inline-flex items-center gap-1.5 bg-white dark:bg-[#0e2019] px-3 py-1 rounded-full text-xs font-semibold text-[#012d1d] dark:text-[#34d399] border border-[#c1c8c2]/50 dark:border-[#1b3b2f]">
						<span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">lock</span>
						Zero Cloud Storage
					</span>
				</div>
			</div>

			<!-- Column 1: Product -->
			<div class="flex flex-col gap-2.5">
				<span class="font-label-caps text-xs font-bold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] mb-1">Product</span>
				<a href="/#workspace-container" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">CSV Cleaner Tool</a>
				<a href="/features" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">Features</a>
				<a href="/tools" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">Tools Directory</a>
				<a href="/use-cases" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">Use Cases</a>
				<a href="/examples" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">Playground</a>
			</div>

			<!-- Column 2: Resources -->
			<div class="flex flex-col gap-2.5">
				<span class="font-label-caps text-xs font-bold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] mb-1">Resources</span>
				<a href="/guides" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">Guides & Tutorials</a>
				<a href="/faq" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">FAQ</a>
				<a href="/how-it-works" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">How It Works</a>
				<a href="/privacy" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">Privacy Architecture</a>
			</div>

			<!-- Column 3: Legal & Support -->
			<div class="flex flex-col gap-2.5">
				<span class="font-label-caps text-xs font-bold uppercase tracking-wider text-[#012d1d] dark:text-[#34d399] mb-1">Company & Legal</span>
				<a href="/contact" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">Contact Support</a>
				<a href="/privacy" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">Privacy Policy</a>
				<a href="/terms" class="text-[#414844] dark:text-[#94a3b8] hover:text-[#012d1d] dark:hover:text-[#34d399] transition-colors py-0.5">Terms of Service</a>
			</div>
		</div>

		<!-- Mobile Quick Actions & Back to Top Bar -->
		<div class="pt-6 border-t border-[#c1c8c2]/60 dark:border-[#1b3b2f] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#57615c] dark:text-[#94a3b8]">
			<div class="flex flex-wrap items-center justify-center sm:justify-start gap-4">
				<span>© {new Date().getFullYear()} CSV Cleaner. All rights reserved.</span>
				<span class="hidden sm:inline">•</span>
				<span>RFC 4180 Compliant</span>
			</div>

			<button
				id="footer-back-to-top"
				type="button"
				class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white dark:bg-[#0e2019] hover:bg-[#d8e2dc] dark:hover:bg-[#162f25] text-[#012d1d] dark:text-[#f0fdf4] border border-[#c1c8c2]/60 dark:border-[#1b3b2f] transition-colors cursor-pointer"
			>
				<span class="material-symbols-outlined text-sm">arrow_upward</span>
				<span>Back to Top</span>
			</button>
		</div>
	</div>
</footer>

<script>
	document.getElementById('footer-back-to-top')?.addEventListener('click', () => {
		window.scrollTo({ top: 0, behavior: 'smooth' });
	});
</script>
